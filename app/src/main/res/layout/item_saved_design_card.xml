<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Preview Thumbnail -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#1E293B">

            <ImageView
                android:id="@+id/ivSavedDesignPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_order_gradient"
                android:contentDescription="Design preview"/>

            <TextView
                android:id="@+id/tvSavedDesignBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINT READY"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="#059669"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSavedDesignName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Design Template Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSavedDesignDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved on: 12 Oct 2026"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrderSavedDesign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Order Now"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnDeleteSavedDesign"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    app:strokeColor="#EF4444"
                    app:cornerRadius="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
