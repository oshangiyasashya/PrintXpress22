<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvUploadHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload your design"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProductSizeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product, Size specs"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp"/>

        <!-- Drop Zone Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="2dp"
            app:strokeColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Upload icon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to choose artwork file"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPickGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Gallery"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnPickFiles"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Files"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnPickCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Camera"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preview ImageView -->
        <ImageView
            android:id="@+id/ivArtworkPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/surface"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:contentDescription="Artwork preview"/>

        <!-- Preview & Status -->
        <TextView
            android:id="@+id/tvUploadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file selected."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmArtwork"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Use this Design"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary"/>

    </LinearLayout>
</ScrollView>
