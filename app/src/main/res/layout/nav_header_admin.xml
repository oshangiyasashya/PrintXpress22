<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="#172554"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAdminAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/printxpress_logo"
            android:background="@drawable/bg_order_gradient"
            android:padding="4dp"
            android:contentDescription="Admin Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvHeaderAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderAdminEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="admin@printxpress.lk"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUPER ADMIN"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#EA580C"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

</LinearLayout>
