<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selection_border"
    android:padding="16dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Color"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginBottom="12dp" />

    <!-- Current vs New Color Preview Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current"
                android:textSize="10sp"
                android:textColor="#6B7280" />
            <View
                android:id="@+id/viewCurrentColor"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New"
                android:textSize="10sp"
                android:textColor="#6B7280" />
            <View
                android:id="@+id/viewNewColor"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab / View Mode Buttons (Palette vs Custom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabPalette"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Palette"
            android:textAllCaps="false"
            android:backgroundTint="#3B82F6"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabCustom"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Custom"
            android:textAllCaps="false"
            android:textColor="#3B82F6" />
    </LinearLayout>

    <!-- Container for Palette View -->
    <LinearLayout
        android:id="@+id/layoutPaletteContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Colors"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecentColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color Swatches"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPaletteColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

    <!-- Container for Custom Color View -->
    <LinearLayout
        android:id="@+id/layoutCustomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Saturation / Brightness Box -->
        <com.printxpress.ui.colorpicker.SaturationBrightnessView
            android:id="@+id/viewSaturationBrightness"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="12dp" />

        <!-- Hue Slider -->
        <com.printxpress.ui.colorpicker.HueSliderView
            android:id="@+id/viewHueSlider"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp" />

        <!-- Sub-tabs for HSB / RGB / Web -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnSubTabHsb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HSB"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:padding="8dp" />

            <TextView
                android:id="@+id/btnSubTabRgb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RGB"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:padding="8dp" />

            <TextView
                android:id="@+id/btnSubTabWeb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Web"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:padding="8dp" />
        </LinearLayout>

        <!-- HSB Inputs Layout -->
        <LinearLayout
            android:id="@+id/layoutHsbInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvHsbValues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H: 0°  S: 100%  B: 100%"
                android:textSize="12sp"
                android:textColor="#4B5563"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekHsbH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="360"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekHsbS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekHsbB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
        </LinearLayout>

        <!-- RGB Inputs Layout -->
        <LinearLayout
            android:id="@+id/layoutRgbInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvRgbValues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R: 255  G: 255  B: 255"
                android:textSize="12sp"
                android:textColor="#4B5563"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekRgbR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekRgbG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seekRgbB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255" />
        </LinearLayout>

        <!-- Web Hex Input Layout -->
        <LinearLayout
            android:id="@+id/layoutWebInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hex Color (#RRGGBB)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWebHex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword"
                    android:maxLength="9" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons (Save/Use and Cancel) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelColor"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#6B7280"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseColor"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use Color"
            android:backgroundTint="#3B82F6"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
